{
  "name": "sensorchain",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "postCreateCommand": "pip install -r requirements.txt && pip install -e .",
  "forwardPorts": [8501],
  "portsAttributes": { "8501": { "label": "Dashboard", "onAutoForward": "openBrowser" } },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "NomicFoundation.hardhat-solidity"] }
  }
}
